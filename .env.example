# Pilih provider: 'openai' atau 'gemini'
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Maksimal ukuran file upload (MB). Untuk aman di Vercel: maks 4 (batas body 4.5MB)
MAX_FILE_SIZE_MB=4
MAX_TEXT_LENGTH=12000

# --- Autentikasi (NextAuth + Neon) ---
# Database Neon (Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Rahasia untuk enkripsi session (jalankan: npx auth secret)
AUTH_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxx

# Wajib 'true' saat produksi di Vercel (auth di belakang proxy)
AUTH_TRUST_HOST=true
